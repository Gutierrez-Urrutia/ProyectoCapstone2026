@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #181818
skinparam usecase {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
skinparam actor {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
skinparam rectangle {
  BorderColor #181818
}

actor "Ejecutivo de Ventas" as Ej
actor "Gerente de Ventas" as Ge
actor "Servicio de IA\n(DeepSeek + RAG)" as IA
actor "CRM\n(HubSpot / Salesforce)" as CRM

rectangle "Módulo de Propuestas" {
  usecase "Generar propuesta comercial" as UC1
  usecase "Personalizar por perfil de cliente" as UC2
  usecase "Editar y refinar propuesta" as UC3
  usecase "Gestionar ciclo de vida" as UC4
  usecase "Registrar propuesta firmada\n(adjunta documento)" as UC5
  usecase "Registrar en CRM" as UC6
  usecase "Exportar propuesta\n(PDF / DOCX)" as UC7
  usecase "Consultar historial\nde versiones" as UC8
  usecase "Gestionar plantillas" as UC9
  usecase "Gestionar catálogo y precios" as UC10
}

Ej --> UC1
Ej --> UC3
Ej --> UC4
Ej --> UC7
Ej --> UC8
Ge --> UC9
Ge --> UC10

UC2 .> UC1 : <<extend>>
UC5 .> UC4 : <<extend>>
UC6 .> UC4 : <<extend>>

UC1 --> IA
UC6 --> CRM
@enduml
