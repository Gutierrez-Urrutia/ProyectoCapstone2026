@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #181818
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #555555
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #555555
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #888888
}
skinparam swimlane {
  BorderColor #181818
  BorderThickness 1
}
title Personalizar Propuesta por Perfil de Cliente (RF-VTA-03)\nDiagrama de Actividad - Industria, tamaño e historial
|Usuario|
|Sistema / Backend|
|Servicio de IA (DeepSeek + RAG)|
|Usuario|
start
:Selecciona el cliente de la propuesta;
|Sistema / Backend|
:Carga el perfil del cliente\n(industria, tamaño e historial de propuestas);
if (¿El cliente tiene industria y tamaño registrados?) then (no)
  |Usuario|
  :Completa la industria y el tamaño del cliente;
  |Sistema / Backend|
  :Guarda el perfil del cliente;
else (sí)
endif
:Vincula la propuesta al cliente;
|Servicio de IA (DeepSeek + RAG)|
:Recupera el contexto histórico\nsegún cliente y servicio;
:Genera el contenido incorporando\nla industria y el tamaño del cliente;
|Usuario|
:Revisa la versión personalizada;
if (¿Necesita ajustes manuales?) then (sí)
  :Edita las secciones necesarias;
else (no)
endif
|Sistema / Backend|
:Guarda la propuesta con una nueva versión;
:Registra la acción en auditoría;
|Usuario|
:Consulta el historial del cliente\ndesde la propuesta;
stop
@enduml
