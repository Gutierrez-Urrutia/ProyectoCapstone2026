@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #181818
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #555555
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #555555
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #888888
}
skinparam swimlane {
  BorderColor #181818
  BorderThickness 1
}
title Asistente Conversacional de Ventas (RF-VTA-09)\nDiagrama de Actividad - Asistente único, solo consulta
|Usuario|
|Sistema / Backend|
|Servicio de IA (DeepSeek + RAG)|
|Usuario|
start
:Escribe una consulta en el asistente;
|Sistema / Backend|
:Identifica al usuario y obtiene su alcance\n(sus clientes, propuestas y catálogo);
|Servicio de IA (DeepSeek + RAG)|
:Interpreta la consulta;
if (¿Pide modificar datos o ver datos de otros usuarios?) then (sí)
  :Responde que el asistente es de solo consulta\ny no entrega datos de otros usuarios;
else (no)
  :Genera la respuesta solo con los datos\ndel propio usuario;
endif
|Sistema / Backend|
:Registra la interacción en el historial de IA;
if (¿El servicio de IA respondió?) then (no)
  :Informa la falla al usuario sin detener la aplicación;
else (sí)
endif
|Usuario|
:Recibe la respuesta;
stop
@enduml
