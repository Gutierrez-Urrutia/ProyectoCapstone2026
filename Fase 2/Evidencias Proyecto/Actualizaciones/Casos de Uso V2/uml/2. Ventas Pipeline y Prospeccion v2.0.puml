@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #181818
skinparam usecase {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
skinparam actor {
  BackgroundColor #F1F1F1
  BorderColor #181818
}
skinparam rectangle {
  BorderColor #181818
}

actor "Ejecutivo de Ventas" as Ej
actor "Gerente de Ventas" as Ge
actor "Servicio de IA\n(DeepSeek + RAG)" as IA
actor "Fuentes de empleo" as FE

rectangle "Sistema de Ventas - Pipeline y Prospección" {
  usecase "Configurar y ejecutar\npipeline de prospección" as UC1
  usecase "Detectar y calificar vacantes\n(Agente 1, Job Scout)" as UC2
  usecase "Redactar y revisar correos\nen Review Queue (Agente 3)" as UC3
  usecase "Consultar asistente\nconversacional" as UC4
  usecase "Generar material de\nsales enablement" as UC5
  usecase "Consultar y exportar\nreportes de pipeline" as UC6
}

Ej --> UC1
Ej --> UC3
Ej --> UC4
Ej --> UC5
Ge --> UC6

UC1 .> UC2 : <<include>>

UC2 --> FE
UC3 --> IA
UC4 --> IA
UC5 --> IA
@enduml
